```gitignore
# ----------------------------------------
# Dependencies
# ----------------------------------------
node_modules/
.bun/
.pnpm-store/

# ----------------------------------------
# Expo / React Native generated
# ----------------------------------------
.expo/
.expo-shared/
dist/
web-build/

# Native generated folders (ignore if using managed Expo)
android/
ios/

# Metro / Bundler caches
.metro/
.cache/
.tmp/
tmp/

# ----------------------------------------
# Build Artifacts
# ----------------------------------------
build/
coverage/
*.tsbuildinfo

# ----------------------------------------
# Logs
# ----------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------------------
# Environment / Secrets
# ----------------------------------------
.env
.env.*
!.env.example

# ----------------------------------------
# Git / Editor
# ----------------------------------------
.git/
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ----------------------------------------
# Test Output
# ----------------------------------------
jest-coverage/
playwright-report/
test-results/

# ----------------------------------------
# Drizzle Generated Artifacts
# Keep schema source, ignore generated output
# ----------------------------------------
drizzle/meta/
*.sqlite
*.sqlite-journal

# If local dev DB lives in a data folder:
data/*.db
data/*.sqlite

# ----------------------------------------
# Assets Cursor doesn't need for coding
# (keep small referenced assets in repo if needed)
# ----------------------------------------
assets/videos/**
assets/audio/**
assets/fonts/**
*.mp4
*.mov
*.wav
*.psd
*.ai
*.sketch

# ----------------------------------------
# Large docs / generated docs
# ----------------------------------------
docs/archive/**
docs/generated/**

# ----------------------------------------
# Ignore generated types or codegen
# ----------------------------------------
generated/**
*.generated.ts

# ----------------------------------------
# Expo update artifacts
# ----------------------------------------
.eas/
```
